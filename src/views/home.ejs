<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Orange Egypt | Campaigns</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@500;700;800;900&display=swap" rel="stylesheet">

<style>
:root{
  --orange:#ff7900;
  --black:#000;
  --white:#fff;
  --light-gray:#ededed;
}

*{ box-sizing:border-box; }

body{
  margin:0;
  background:#ffffff;
  color:#000;
  font-family:Arial, Helvetica, sans-serif;
}

/* ================= HEADER ================= */

.home-header{
  background:#000;
  height:64px;
  display:flex;
  align-items:center;
}

.home-header__inner{
  max-width:1400px;
  width:100%;
  margin:auto;
  padding:0 40px;
  display:flex;
  justify-content:space-between;
  align-items:center;
}

.brand img{ height:36px; }

.home-nav{
  display:flex;
  gap:32px;
}

.nav-link{
  color:#fff;
  text-decoration:none;
  font-weight:600;
  font-size:15px;
}

.nav-link:hover{ color:var(--orange); }

/* ================= SLIDER ================= */

.campaigns{
  max-width:1400px;
  margin:60px auto;
  padding:0 24px;
}

.campaigns__title{
  font-size:32px;
  font-weight:900;
  margin-bottom:24px;
  text-align:right;
  font-family:'Cairo',sans-serif;
}

.slider{
  position:relative;
  overflow:hidden;
  direction:ltr;
}

.slider-track{
  display:flex;
  transition:transform .5s ease;
}

.campaign-card{
  min-width:100%;
  background:#111;
  border-radius:12px;
  overflow:hidden;
}

.campaign-card img{
  width:100%;
  height:600px;
  object-fit:contain;
  background:#000;
  display:block;
}

.slider-btn{
  position:absolute;
  top:50%;
  transform:translateY(-50%);
  width:46px;
  height:46px;
  border-radius:50%;
  border:none;
  cursor:pointer;
  background:var(--orange);
  color:#000;
  font-size:22px;
  font-weight:bold;
  z-index:10;
}

.slider-btn.prev{ left:20px; }
.slider-btn.next{ right:20px; }

/* ================= SOCIAL ================= */

.social-section{
  background:#000;
  padding:40px 0;
  border-top:1px solid #222;
}

.social-inner{
  max-width:1400px;
  margin:auto;
  padding:0 40px;
  display:flex;
  align-items:center;
  gap:30px;
  direction:ltr;
}

.social-title{
  color:#fff;
  font-weight:600;
  font-size:16px;
}

.social-icons{
  display:flex;
  gap:20px;
}

.social-icons a{
  width:46px;
  height:46px;
  border:2px solid #fff;
  border-radius:50%;
  display:flex;
  align-items:center;
  justify-content:center;
  text-decoration:none;
  transition:.3s;
}

.social-icons a svg{
  width:20px;
  height:20px;
  fill:#fff;
}

.social-icons a:hover{
  border-color:var(--orange);
}

.social-icons a:hover svg{
  fill:var(--orange);
}

/* ================= FOOTER ================= */

.footer{
  background:#000;
  padding:70px 0;
  border-top:1px solid #222;
}

.footer-inner{
  max-width:1400px;
  margin:auto;
  padding:0 40px;
  display:flex;
  gap:120px;
  direction:ltr;
}

.footer-column{
  flex:1;
}

.footer-column h4{
  color:#fff;
  font-size:18px;
  font-weight:700;
  margin-bottom:25px;
}

.footer-column a{
  display:block;
  color:#fff;
  text-decoration:none;
  font-size:14px;
  margin-bottom:14px;
  transition:.2s;
}

.footer-column a:hover{
  color:var(--orange);
}

@media(max-width:768px){
  .campaign-card img{ height:300px; }

  .footer-inner{
    flex-direction:column;
    gap:40px;
  }

  .social-inner{
    flex-direction:column;
    gap:20px;
  }
}
</style>
</head>

<body>

<header class="home-header">
  <div class="home-header__inner">
    <a class="brand" href="/">
      <img src="https://i.ibb.co/RTFb3J9D/Orange-Egypt-Logo-wine.png">
    </a>

    <nav class="home-nav">
      <a class="nav-link" href="/signup?type=influencer">بوابة تسجيل المؤثرين</a>
      <a class="nav-link" href="/signup?type=entrepreneur">بوابة تسجيل رواد الأعمال</a>
